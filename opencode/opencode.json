{
	"$schema": "https://opencode.ai/config.json",
	"theme": "system",
	"tools": {
		"webfetch": false,
	},
	"provider": {
		"ollama": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Ollama (local)",
			"options": {
				"baseURL": "http://localhost:11434/v1",
				"timeout": 300000
			},
			"models": {
				"gpt-oss:20b": {
					"name": "gpt-oss:20b",
					"tool_call": true
				},
				"ministral-3:3b": {
					"name": "ministral-3:3b",
					"tool_call": true,
				},
				"deepseek-r1:14b": {
					"name": "deepseek-r1:14b",
					"tool_call": true,
				},
			}
		}
	}
}
